# Generate two DIFFERENT random values:
# python -c "import secrets; print(secrets.token_urlsafe(32)); print(secrets.token_urlsafe(32))"
SMSFORWARDER_SECRET=REPLACE_WITH_RANDOM_SMSFORWARDER_SECRET
OTP_CONSUMER_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_CONSUMER_TOKEN

# Primary SMS allowlist. Match the original body instead of relying on a
# banking sender phone number, which may change.
OTP_ALLOWED_MESSAGE_PATTERN=(?s)(?=.*?玉山卡網路消費)(?=.*網頁識別碼)(?=.*交易驗證碼\s*[:：]?\s*\d{6})

# Optional additional sender restriction. Leave empty unless stable.
OTP_ALLOWED_SENDER_PATTERN=
SMSFORWARDER_MAX_SKEW_SECONDS=300
OTP_TTL_SECONDS=300
OTP_MAX_LONG_POLL_SECONDS=30
OTP_HOST=127.0.0.1
OTP_PORT=8000

# fee.py client settings (consumer token is shared only with the relay process)
OTP_SERVER_URL=https://opt.yurishop.xyz

# Optional legacy/manual JSON upload endpoint; SmsForwarder does not use this.
OTP_UPLOAD_TOKEN=
