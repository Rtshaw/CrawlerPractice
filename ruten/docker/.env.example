# Copy to .env on the VPS and replace every REPLACE_* value.
# Generate secrets:
# python3 -c "import secrets; print(secrets.token_urlsafe(32)); print(secrets.token_urlsafe(32))"
SMSFORWARDER_SECRET=REPLACE_WITH_RANDOM_SMSFORWARDER_SECRET
OTP_CONSUMER_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_CONSUMER_TOKEN

# Primary SMS allowlist. Match the original SMS body; banking sender numbers
# may change. The pattern requires the three E.SUN markers and a 6-digit OTP.
OTP_ALLOWED_MESSAGE_PATTERN=(?s)(?=.*?玉山卡網路消費)(?=.*網頁識別碼)(?=.*交易驗證碼\s*[:：]?\s*\d{6})

# Optional secondary sender restriction. Leave empty unless stable.
OTP_ALLOWED_SENDER_PATTERN=
SMSFORWARDER_MAX_SKEW_SECONDS=300
OTP_TTL_SECONDS=300
OTP_MAX_LONG_POLL_SECONDS=30
OTP_AUDIT_LOG_BACKUP_COUNT=30
OTP_AUDIT_LOG_MAX_BYTES=10485760

# Optional legacy/manual upload endpoint; SmsForwarder does not use it.
OTP_UPLOAD_TOKEN=

# Existing Traefik settings. Change these names to match the VPS.
OTP_DOMAIN=opt.yurishop.xyz
TRAEFIK_NETWORK=traefik
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
